<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CYAC.Port.Transform — `cyac-transform`, the data-transform tool.

    Plan of record: doc/port-data-transform-plan.md.  It turns the shipping originals
    (yeager.exe, the six EALIB archives, yeager.cfg) into an OPEN, READABLE, EDITABLE data tree
    (JSON / PNG / WAV).  Every transform ships its inverse; the verify mode re-encodes the tree
    and diffs it against the originals (law L3).

    DEPENDENCY RULE (native-port-plan §9b, transform-plan §2): a CYAC.Port.* project references
    clean libraries only.  NEVER CYAC.Emulator*.

    LAW L1: no original game bytes live in this project.  Digests, offsets, layouts and formulas
    are knowledge and do ship; tables, images and records do not.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>cyac-transform</AssemblyName>
    <RootNamespace>CYAC.Port.Transform</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ★ M1 — the oracle tests read documents back through the tool's OWN source-generated
      serialisation context (TransformJsonContext) instead of a reflection-based deserialise, so
      the doctrine at the top of Json/TransformJsonContext.cs holds in the tests too.
    -->
    <InternalsVisibleTo Include="CYAC.Port.Transform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CYAC.Formats\CYAC.Formats.csproj" />
    <ProjectReference Include="..\CYAC.Port.Core\CYAC.Port.Core.csproj" />
  </ItemGroup>

</Project>
