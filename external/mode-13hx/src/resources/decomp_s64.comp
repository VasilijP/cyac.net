#version 450

// S64 fixed-rate 1D wavelet decompressor
// Each block: 64 consecutive pixels packed into 8 uints (256 bits).
// One workgroup per block, 32 threads (2 pixels per thread).
// 1D Haar, 6 levels. Coefficient layout: [DC, L6×1, L5×2, L4×4, L3×8, L2×16, L1×32(zeroed)]
//
// Bit layout (must match CPU encoder):
//   Y(128): DC(8u) + L6(8s) + L5(2×6s) + L4(4×5s) + L3(8×4s) + L2(16×3s)
//   Co(64): DC(8s) + L6(6s) + L5(2×5s) + L4(4×4s) + L3(8×3s)
//   Cg(64): same as Co

#define BLOCK_PIXELS 64
#define BLOCK_UINTS 8

// Q factors as shift counts (dequantize = value << shift)
#define SY_DC  0
#define SY_L6  1
#define SY_L5  2
#define SY_L4  3
#define SY_L3  4
#define SY_L2  5
#define SC_DC  1
#define SC_L6  2
#define SC_L5  3
#define SC_L4  4
#define SC_L3  5

layout(local_size_x = 32) in;
layout(set = 0, binding = 0) buffer CompressedBlocks { uint blocks[]; };
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outputImage;
layout(push_constant) uniform PushConstants { uint Width; uint Height; };

shared uint blockData[BLOCK_UINTS];
shared int coeffs[3][BLOCK_PIXELS]; // Y, Co, Cg

// ── Bit reading helpers ──────────────────────────────────────────────────────
uint readBits(int bitPos, int bits)
{
    int wordIdx = bitPos >> 5;
    int bitIdx = bitPos & 31;
    uint mask = (1u << bits) - 1u;
    uint value = (blockData[wordIdx] >> bitIdx) & mask;
    if (bitIdx + bits > 32)
        value |= (blockData[wordIdx + 1] << (32 - bitIdx)) & mask;
    return value;
}

int readBitsSigned(int bitPos, int bits)
{
    uint raw = readBits(bitPos, bits);
    if ((raw & (1u << (bits - 1))) != 0u)
        raw |= ~((1u << bits) - 1u);
    return int(raw);
}

// ── Inverse 1D Haar (single level, in-place with temp) ──────────────────────
// Operates on coeffs[ch][base..base+n-1]: smooth in [base..base+h-1], detail in [base+h..base+n-1]
void inverseHaar1DLevel(int ch, int n)
{
    int h = n / 2;
    // Must use temp to avoid overwrite conflicts (smooth at [0..h-1], detail at [h..n-1])
    int tmp[64];
    for (int i = 0; i < h; i++)
    {
        int s = coeffs[ch][i];
        int d = coeffs[ch][h + i];
        int even = s - (d >> 1);
        int odd = d + even;
        tmp[2 * i] = even;
        tmp[2 * i + 1] = odd;
    }
    for (int i = 0; i < n; i++)
        coeffs[ch][i] = tmp[i];
}

void main()
{
    uint blockIndex = gl_WorkGroupID.x;
    uint localId = gl_LocalInvocationID.x; // 0..31

    // Load block data into shared memory
    if (localId < uint(BLOCK_UINTS))
        blockData[localId] = blocks[blockIndex * uint(BLOCK_UINTS) + localId];
    barrier();

    // ── Unpack coefficients (single thread) ──
    if (localId == 0u)
    {
        // Zero all (L1 for Y and L2+L1 for Co/Cg are not stored)
        for (int i = 0; i < BLOCK_PIXELS; i++) { coeffs[0][i] = 0; coeffs[1][i] = 0; coeffs[2][i] = 0; }

        int bp = 0;

        // === Y channel (128 bits) ===
        // DC [0]
        coeffs[0][0] = int(readBits(bp, 8)); bp += 8;
        // L6 [1]
        coeffs[0][1] = readBitsSigned(bp, 8) * (1 << SY_L6); bp += 8;
        // L5 [2..3]
        for (int i = 0; i < 2; i++) { coeffs[0][2+i] = readBitsSigned(bp, 6) * (1 << SY_L5); bp += 6; }
        // L4 [4..7]
        for (int i = 0; i < 4; i++) { coeffs[0][4+i] = readBitsSigned(bp, 5) * (1 << SY_L4); bp += 5; }
        // L3 [8..15]
        for (int i = 0; i < 8; i++) { coeffs[0][8+i] = readBitsSigned(bp, 4) * (1 << SY_L3); bp += 4; }
        // L2 [16..31]
        for (int i = 0; i < 16; i++) { coeffs[0][16+i] = readBitsSigned(bp, 3) * (1 << SY_L2); bp += 3; }
        // L1 [32..63]: zeroed

        // === Co channel (64 bits) ===
        coeffs[1][0] = readBitsSigned(bp, 8) * (1 << SC_DC); bp += 8;
        coeffs[1][1] = readBitsSigned(bp, 6) * (1 << SC_L6); bp += 6;
        for (int i = 0; i < 2; i++) { coeffs[1][2+i] = readBitsSigned(bp, 5) * (1 << SC_L5); bp += 5; }
        for (int i = 0; i < 4; i++) { coeffs[1][4+i] = readBitsSigned(bp, 4) * (1 << SC_L4); bp += 4; }
        for (int i = 0; i < 8; i++) { coeffs[1][8+i] = readBitsSigned(bp, 3) * (1 << SC_L3); bp += 3; }

        // === Cg channel (64 bits) ===
        coeffs[2][0] = readBitsSigned(bp, 8) * (1 << SC_DC); bp += 8;
        coeffs[2][1] = readBitsSigned(bp, 6) * (1 << SC_L6); bp += 6;
        for (int i = 0; i < 2; i++) { coeffs[2][2+i] = readBitsSigned(bp, 5) * (1 << SC_L5); bp += 5; }
        for (int i = 0; i < 4; i++) { coeffs[2][4+i] = readBitsSigned(bp, 4) * (1 << SC_L4); bp += 4; }
        for (int i = 0; i < 8; i++) { coeffs[2][8+i] = readBitsSigned(bp, 3) * (1 << SC_L3); bp += 3; }
    }
    barrier();

    // ── Inverse 1D Haar (6 levels, per channel) ──
    // Threads 0-2 each handle one channel
    if (localId < 3u)
    {
        int ch = int(localId);
        int n = 2; // start from coarsest (level 6 → 2 values)
        for (int level = 5; level >= 0; level--)
        {
            inverseHaar1DLevel(ch, n);
            n *= 2;
        }
    }
    barrier();

    // ── Inverse YCoCg-R → RGB and write pixels ──
    // 32 threads handle 64 pixels (2 per thread)
    for (uint p = 0u; p < 2u; p++)
    {
        uint pixelIdx = localId * 2u + p;
        uint target = blockIndex * uint(BLOCK_PIXELS) + pixelIdx;
        uint px = target % Width;
        uint py = target / Width;

        if (px < Width && py < Height)
        {
            int Y  = coeffs[0][pixelIdx];
            int Co = coeffs[1][pixelIdx];
            int Cg = coeffs[2][pixelIdx];

            int t = Y - (Cg >> 1);
            int G = Cg + t;
            int B = t - (Co >> 1);
            int R = Co + B;

            R = clamp(R, 0, 255);
            G = clamp(G, 0, 255);
            B = clamp(B, 0, 255);

            vec4 color = vec4(float(R), float(G), float(B), 255.0) / 255.0;
            imageStore(outputImage, ivec2(int(px), int(py)), color);
        }
    }
}
